    have hM : constantCoeff ((-32*X^23*W*P*Ph*Q + 32*X^22*T*P*Ph + 352*X^21*W*P*Ph*Q - 352*X^20*T*P*Ph - 1760*X^19*W*P*Ph*Q + 1760*X^18*T*P*Ph + 5280*X^17*W*P*Ph*Q - 5280*X^16*T*P*Ph - 10560*X^15*W*P*Ph*Q + 10560*X^14*T*P*Ph + 14784*X^13*W*P*Ph*Q - 14784*X^12*T*P*Ph - 14784*X^11*W*P*Ph*Q + 14784*X^10*T*P*Ph + 10560*X^9*W*P*Ph*Q - 10560*X^8*T*P*Ph - 5280*X^7*W*P*Ph*Q + 5280*X^6*T*P*Ph + 1760*X^5*W*P*Ph*Q - 1760*X^4*T*P*Ph - 352*X^3*W*P*Ph*Q + 352*X^2*T*P*Ph + 32*X*W*P*Ph*Q - 32*T*P*Ph) * (1 - X ^ 2)) = -32 * t * (1 - t) := by
      simp (config := { maxSteps := 10000000 }) only [map_add, map_sub, map_mul, map_pow, map_neg, map_one, constantCoeff_X, hcP, hcPh, cQ, cQ1, cQh1, cP1, cPh1, hT, hW, constantCoeff_C, map_ofNat, zero_pow, ne_eq, OfNat.ofNat_ne_zero, not_false_eq_true, mul_zero, zero_mul, add_zero, zero_add, sub_zero]
      try ring
    rcases Nat.eq_zero_or_pos n with rfl | hn
    · left
      rw [coeff_zero_eq_constantCoeff_apply]
      simp (config := { maxSteps := 10000000 }) only [map_add, map_sub, map_mul, map_pow, map_neg, map_one, constantCoeff_X, hcP, hcPh, cQ, cQ1, cQh1, cP1, cPh1, hT, hW, constantCoeff_C, map_ofNat, zero_pow, ne_eq, OfNat.ofNat_ne_zero, not_false_eq_true, mul_zero, zero_mul, add_zero, zero_add, sub_zero]
      try ring
    · right
      rw [hc6, hM]
      exact mul_ne_zero (Nat.cast_ne_zero.mpr hn.ne') (mul_ne_zero (mul_ne_zero (by norm_num) ht0)
        (sub_ne_zero.mpr (Ne.symm ht1)))
end AvgRS
