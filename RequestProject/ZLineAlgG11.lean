      (zb_ne_zero Z ht1 hw1)) (mul_ne_zero (mul_ne_zero (mul_ne_zero (pow_ne_zero 2 (zps_C_ne_zero ht0))
      (zps_C_ne_zero hw0)) X_ne_zero) hPs)
  have e := sub_eq_zero.mp ((mul_eq_zero.mp main).resolve_left hM)
  refine eq_zero_of_X_mul_deriv e (fun n => ?_)
  have h12 := zlow12 Z
  have hl := zlow0 Z
  by_cases hn : n = 2
  · left; subst hn
    rw [show (1 - X ^ 2 : ℚ⟦X⟧) ^ 4 = 1 - 4 * X ^ 2 + 6 * X ^ 4 - 4 * X ^ 6 + X ^ 8 by ring]
    simp [coeff_mul, Finset.Nat.sum_antidiagonal_succ, coeff_X, coeff_X_pow, Z.hcG11, Z.hcP, Z.hcPh,
      h12.2.2.2.1, h12.2.2.2.2.2.1, h12.2.2.2.2.2.2.1, h12.2.2.2.2.2.2.2.1, h12.2.2.2.2.2.2.2.2.2.1,
      h12.2.2.2.2.2.2.2.2.2.2, hl.2.2.2.1]
    simp only [map_ofNat, show ((1 - C t) ^ 2 : ℚ⟦X⟧) = C ((1 - t) ^ 2) by
      simp only [map_sub, map_one, map_pow], coeff_C, OfNat.ofNat_ne_zero, if_false]
    ring
  · right
    simp
    intro h; apply hn
    simp only [map_ofNat] at h
    have : (n : ℚ) = 2 := by linear_combination h
    exact_mod_cast this
end AvgRS
